# MyManaBox settings.
# Copy this file to .env (cp .env.example .env) and put your own values there.
# .env is listed in .gitignore, so it never gets committed. This example file has no secrets.
#
# Scryfall needs no API key. ManaGuide calls Gemini from the local Node server,
# so its real API key belongs in .env or .env.gemini and never in browser code.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Gemini 3.6 Flash was selected for the reliable default. The server tries the
# fallback only for temporary/model-availability failures.
GEMINI_APP_MODEL=gemini-3.6-flash
GEMINI_APP_FALLBACK_MODELS=gemini-3.8-flash

# The name the app gives Scryfall in the User-Agent header. Scryfall asks for contact info here.
SCRYFALL_USER_AGENT=MyManaBox/1.0 (github.com/your-github-name)
